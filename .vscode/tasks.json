{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build JAR (Dead Air)",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": ["build", "--no-daemon"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {}
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}
